# Copy to .env and set only the key to get started. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Must match the chosen model's actual context capacity.
OPENROUTER_CONTEXT_TOKENS=128000
OPENROUTER_MAX_OUTPUT_TOKENS=4096
DATABASE_URL=postgresql+psycopg://docvault:docvault@localhost:15432/docvault
REDIS_URL=redis://localhost:16379/0
STORAGE_PATH=./data
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_BYTES=26214400
# Zero disables optional local demo quotas; no IAM or extracted-token cap.
DAILY_BUDGET_USD=0
CHAT_RATE_PER_MINUTE=20
UPLOAD_RATE_PER_HOUR=20
