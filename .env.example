# Copy to .env and set only the key to get started. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
# Chat settings retain the existing environment variable names.
OPENROUTER_CONTEXT_TOKENS=128000
OPENROUTER_MAX_OUTPUT_TOKENS=4096
# Each task can select its own model and capacities (all capacities must fit the model).
OPENROUTER_INPUT_QUERY_REWRITE_MODEL=openai/gpt-4.1-nano
OPENROUTER_INPUT_QUERY_REWRITE_CONTEXT_TOKENS=128000
OPENROUTER_INPUT_QUERY_REWRITE_MAX_OUTPUT_TOKENS=1024
OPENROUTER_SUMMARY_MODEL=openai/gpt-4.1-mini
OPENROUTER_SUMMARY_CONTEXT_TOKENS=128000
OPENROUTER_SUMMARY_MAX_OUTPUT_TOKENS=4096
OPENROUTER_COMPARISON_MODEL=openai/gpt-4.1
OPENROUTER_COMPARISON_CONTEXT_TOKENS=128000
OPENROUTER_COMPARISON_MAX_OUTPUT_TOKENS=4096
# Optional OPENROUTER_<TASK>_TEMPERATURE: omit to use the provider default.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENROUTER_EMBEDDING_MAX_INPUT_TOKENS=8191
OPENROUTER_EMBEDDING_MAX_BATCH_INPUTS=64
OPENROUTER_EMBEDDING_MAX_BATCH_TOKENS=32000
DATABASE_URL=postgresql+psycopg://docvault:docvault@localhost:15432/docvault
REDIS_URL=redis://localhost:16379/0
STORAGE_PATH=./data
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_BYTES=26214400
# Zero disables optional local demo quotas; no IAM or extracted-token cap.
DAILY_BUDGET_USD=0
CHAT_RATE_PER_MINUTE=20
UPLOAD_RATE_PER_HOUR=20
# Per ingestion process; reduce CPU threads when running several workers on one host.
DOCLING_NUM_THREADS=4
# Optional DOCLING_PARSER_THREADS overrides the PDF decoder threads; otherwise uses the above.
DOCLING_LAYOUT_BATCH_SIZE=4
DOCLING_OCR_BATCH_SIZE=4
DOCLING_TABLE_BATCH_SIZE=4
