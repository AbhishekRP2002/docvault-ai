# Copy to .env and set your key. Never commit .env.
OPENROUTER_API_KEY=

# Optional model selection. Token limits and batching use code defaults.
OPENROUTER_CHAT_MODEL=openai/gpt-6-luna
OPENROUTER_CONVERSATION_SUMMARY_MODEL=openai/gpt-5.6-luna
OPENROUTER_SUMMARY_MODEL=openai/gpt-5.6-luna
OPENROUTER_COMPARISON_MODEL=openai/gpt-5.6-luna
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional reasoning effort: none, low, medium, high, xhigh, max.
# Both Luna models default to medium when these overrides are omitted.
OPENROUTER_CHAT_REASONING_EFFORT=medium
OPENROUTER_CONVERSATION_SUMMARY_REASONING_EFFORT=medium
OPENROUTER_SUMMARY_REASONING_EFFORT=medium
OPENROUTER_COMPARISON_REASONING_EFFORT=medium

# Maximum tool-use rounds per answer; each round may call multiple tools.
AGENT_MAX_TOOL_ROUNDS=20

# Local development connections. Docker Compose supplies its own values.
DATABASE_URL=postgresql+psycopg://docvault:docvault@localhost:15432/docvault
REDIS_URL=redis://localhost:16379/0
STORAGE_PATH=./data
